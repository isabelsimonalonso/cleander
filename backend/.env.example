# CLEANDER - Configuración de Seguridad Producción
# CRÍTICO: Cambiar todos estos valores ANTES de lanzar a producción

# ═══════════════════════════════════════════════════════════════
# 🔐 JWT_SECRET - MUY IMPORTANTE
# ═══════════════════════════════════════════════════════════════
# Generar un secret fuerte (mínimo 32 caracteres aleatorios)
#
# Opción 1 - Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Opción 2 - OpenSSL:
#   openssl rand -hex 32
#
# Opción 3 - Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# NUNCA usar valores como "cleander_secret_dev_key_2026"
JWT_SECRET=your_super_secure_random_32_chars_hex_string_here

# ═══════════════════════════════════════════════════════════════
# 📊 Base de Datos
# ═══════════════════════════════════════════════════════════════
# Para producción: Migrar a PostgreSQL
# npm install pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cleander_prod
DB_USER=cleander_app
DB_PASSWORD=strong_db_password_here

# ═══════════════════════════════════════════════════════════════
# 🔌 Servidor
# ═══════════════════════════════════════════════════════════════
PORT=5000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
# 🌐 CORS - Origins autorizados
# ═══════════════════════════════════════════════════════════════
CORS_ORIGIN=https://cleander.com,https://www.cleander.com,https://app.cleander.com

# ═══════════════════════════════════════════════════════════════
# 🔑 JWT Configuración
# ═══════════════════════════════════════════════════════════════
# Expiración de tokens: 15 minutos (muy corto, requiere refresh tokens)
JWT_EXPIRY=15m

# ═══════════════════════════════════════════════════════════════
# 📧 Email (para enviar códigos de verificación)
# ═══════════════════════════════════════════════════════════════
# SendGrid, Mailgun, AWS SES, etc.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@cleander.com

# ═══════════════════════════════════════════════════════════════
# 📱 SMS (para verificación de teléfono)
# ═══════════════════════════════════════════════════════════════
# Twilio, AWS SNS, etc.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# ═══════════════════════════════════════════════════════════════
# 🔒 HTTPS Enforcement (producción)
# ═══════════════════════════════════════════════════════════════
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# ═══════════════════════════════════════════════════════════════
# 📊 Análisis y Monitoreo
# ═══════════════════════════════════════════════════════════════
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ═══════════════════════════════════════════════════════════════
# ⚠️ SECURITY CHECKLIST
# ═══════════════════════════════════════════════════════════════
# ✅ JWT_SECRET generado con crypto.randomBytes(32)
# ✅ CORS_ORIGIN configurado solo para dominios permitidos
# ✅ NODE_ENV=production
# ✅ FORCE_HTTPS=true
# ✅ .env NO commitido a Git (.gitignore)
# ✅ Secretos diferentes entre dev/staging/producción
# ✅ Base de datos PostgreSQL en producción (no SQLite)
# ✅ Backups automáticos configurados
# ✅ Monitoreo y alertas configurados (Sentry)
# ✅ SSL/TLS certificate válido en servidor
